{
  "name": "@eventflow/cart-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "ts-node src/main.ts",
    "seed": "ts-node prisma/seed.ts",
    "start:prod": "prisma db push --skip-generate && node dist/main.js",
    "test": "jest"
  },
  "dependencies": {
    "@eventflow/kafka-events": "*",
    "@eventflow/service-common": "*",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.10",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@prisma/client": "^5.14.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "prisma": "^5.14.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/src/**/*.spec.ts"
    ],
    "moduleNameMapper": {
      "^@eventflow/kafka-events$": "<rootDir>/../../packages/kafka-events/src",
      "^@eventflow/service-common$": "<rootDir>/../../packages/service-common/src"
    }
  }
}