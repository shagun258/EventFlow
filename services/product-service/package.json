  "dependencies": { "@eventflow/kafka-events": "*", "@grpc/grpc-js": "^1.10.0", "@grpc/proto-loader": "^0.7.10",
    "@nestjs/common": "^10.3.0", "@nestjs/core": "^10.3.0", "@nestjs/microservices": "^10.3.0", "@nestjs/platform-express": "^10.3.0",
    "@prisma/client": "^5.14.0", "bcryptjs": "^2.4.3", "ioredis": "^5.4.1", "jsonwebtoken": "^9.0.2", "reflect-metadata": "^0.2.0", "rxjs": "^7.8.0" },
  "devDependencies": { "@types/bcryptjs": "^2.4.6", "@types/jest": "^29.5.0", "@types/jsonwebtoken": "^9.0.6", "@types/node": "^20.11.0",
    "jest": "^29.7.0", "prisma": "^5.14.0", "ts-jest": "^29.1.0", "ts-node": "^10.9.2" },
