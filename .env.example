# --- Postgres (one server, one database per service) ---
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=change_me
# Inside Docker use host "postgres"; on your machine use "localhost"
AUTH_DATABASE_URL=postgresql://eventflow:change_me@postgres:5432/auth_db
ORDER_DATABASE_URL=postgresql://eventflow:change_me@postgres:5432/order_db
INVENTORY_DATABASE_URL=postgresql://eventflow:change_me@postgres:5432/inventory_db
# --- Redis: product cache, rate limiting, token blacklist ---
REDIS_URL=redis://redis:6379
# --- Kafka (inside Docker: kafka:9092, from host: localhost:29092) ---
KAFKA_BROKERS=kafka:9092
# --- gRPC (synchronous service-to-service) ---
GRPC_INVENTORY_URL=inventory-service:50051
GRPC_PAYMENT_URL=payment-service:50052
# --- Auth: generate with `openssl rand -hex 32` ---
JWT_SECRET=replace_with_random_value
JWT_EXPIRES_IN=1h

# --- product-service gRPC (used by order-service to price orders server-side) ---
PRODUCT_GRPC_URL=product-service:50062
# --- SIMULATED payments: orders with total above this amount are declined (demo: 3x 4K Monitor = 1047) ---
PAYMENT_FAIL_ABOVE=1000
# --- Optional random decline probability 0..1 (0 = deterministic) ---
PAYMENT_FAILURE_RATE=0
# --- Fake "processing" delay in ms so you can watch PENDING -> PAID ---
PAYMENT_PROCESSING_MS=1000

# --- API gateway (the ONLY service the frontend talks to) ---
# Allowed browser origins for CORS (comma separated)
CORS_ORIGIN=http://localhost:3000
# Per-IP requests per minute (login/register are limited to 10/min separately)
RATE_LIMIT_PER_MIN=120
# Set to "production" to disable GraphQL introspection
NODE_ENV=development
AUTH_GRPC_URL=auth-service:50061
CART_GRPC_URL=cart-service:50054
ORDER_GRPC_URL=order-service:50053
NOTIFICATION_GRPC_URL=notification-service:50055
ANALYTICS_GRPC_URL=analytics-service:50056
